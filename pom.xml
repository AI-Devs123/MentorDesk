<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nexusmind</groupId>
    <artifactId>nexusmind-root</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>nexusmind-api</module>
        <module>nexusmind-security</module>
        <module>nexusmind-agent-workers</module>
        <module>nexusmind-supervisor</module>
        <module>nexusmind-gateway</module>
        <module>nexusmind-rag</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.4</spring-boot.version>
        <dubbo.version>3.2.14</dubbo.version>
        <protobuf.version>3.25.3</protobuf.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 依赖管理 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Dubbo 依赖管理 -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-bom</artifactId>
                <version>${dubbo.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部 API 契约包 -->
            <dependency>
                <groupId>com.nexusmind</groupId>
                <artifactId>nexusmind-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 内部安全模块 -->
            <dependency>
                <groupId>com.nexusmind</groupId>
                <artifactId>nexusmind-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 内部 Agent Workers 模块 -->
            <dependency>
                <groupId>com.nexusmind</groupId>
                <artifactId>nexusmind-agent-workers</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 保留方法参数名，Spring 才能通过反射解析 @RequestParam 等注解 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- Windows + surefire 3.x 已知问题：Boot Manifest 含绝对路径导致
                 junit-platform 报 'other' has different root / failed to discover tests。
                 加此 argLine 关闭类路径 URL 校验即可修复。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 本机 target/ 被外部进程(文件监视器/Defender)锁住导致 resources 拷贝 AccessDenied：
         已写入一次的文件会被外部持有者锁死，之后覆盖/删除都被拒（rm -rf 目录级可成功）。
         解法：构建到每次唯一的目录，文件永不预存故永不撞锁。跑测试传
         -P clean-target -Dslice4.build.dir=target-<模块>-$(date +%s) 即可。
         注：-Dmaven.build.dir 无效，必须用 pom 级 <directory> 覆盖。 -->
    <profiles>
        <profile>
            <id>clean-target</id>
            <properties>
                <slice4.build.dir>target-slice4</slice4.build.dir>
            </properties>
            <build>
                <directory>${project.basedir}/${slice4.build.dir}</directory>
            </build>
        </profile>
    </profiles>
</project>