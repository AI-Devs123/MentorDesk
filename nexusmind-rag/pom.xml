<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nexusmind</groupId>
        <artifactId>nexusmind-root</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nexusmind-rag</artifactId>
    <description>混合检索中枢：Lucene 同索引 BM25 + HNSW KNN 双引擎（Week 7 切片 1）</description>
    <packaging>jar</packaging>

    <properties>
        <lucene.version>9.10.0</lucene.version>
    </properties>

    <dependencies>
        <!-- API 契约（Rag DTO + IHybridSearchService） -->
        <dependency>
            <groupId>com.nexusmind</groupId>
            <artifactId>nexusmind-api</artifactId>
        </dependency>

        <!-- 内部安全模块（AgentRbacContext / AgentRole / 现有 AgentRbacDubboFilter 密钥） -->
        <dependency>
            <groupId>com.nexusmind</groupId>
            <artifactId>nexusmind-security</artifactId>
        </dependency>

        <!-- Spring Boot 核心 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Dubbo Spring Boot Starter（导出 Triple 服务） -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>

        <!-- Nacos 注册中心 -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-registry-nacos</artifactId>
        </dependency>

        <!-- Dubbo Triple 协议 -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-rpc-triple</artifactId>
        </dependency>

        <!-- WebClient：EmbeddingClient 调用 OpenAI 规范 /v1/embeddings -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Lucene 9.10：原生 HNSW KNN + BM25 同索引共存 -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-queryparser</artifactId>
            <version>${lucene.version}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
