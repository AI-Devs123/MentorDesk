{
  "uid": "nexusmind-agent-llm",
  "title": "Agent-Workers · LLM 调用",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "LLM 调用耗时 P95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le, status) (rate(nexusmind_llm_call_seconds_bucket[5m])))", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 2,
      "title": "LLM 调用量（ok/error）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [ { "expr": "sum by (status) (rate(nexusmind_llm_calls_total[5m]))", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 3,
      "title": "累计消耗 Token",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [ { "expr": "sum(rate(nexusmind_llm_tokens_total[5m]))", "legendFormat": "tokens/s" } ]
    },
    {
      "id": 4,
      "title": "LLM 错误率",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [ { "expr": "rate(nexusmind_llm_calls_total{status=\"error\"}[5m]) / clamp_min(rate(nexusmind_llm_calls_total[5m]), 0.001)", "legendFormat": "error-rate" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
