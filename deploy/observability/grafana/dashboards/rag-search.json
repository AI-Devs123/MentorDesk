{
  "uid": "nexusmind-rag-search",
  "title": "RAG · 混合检索",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "检索耗时 P95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le, rerank) (rate(nexusmind_rag_hybrid_search_seconds_bucket[5m])))", "legendFormat": "rerank={{rerank}}" } ]
    },
    {
      "id": 2,
      "title": "检索调用量（ok/error，按 rerank）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [ { "expr": "sum by (status, rerank) (rate(nexusmind_rag_hybrid_search_total[5m]))", "legendFormat": "{{status}}/rerank={{rerank}}" } ]
    },
    {
      "id": 3,
      "title": "单次返回候选条数（分布）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [ { "expr": "nexusmind_rag_candidates", "legendFormat": "candidates" } ]
    },
    {
      "id": 4,
      "title": "检索错误率",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [ { "expr": "rate(nexusmind_rag_hybrid_search_total{status=\"error\"}[5m]) / clamp_min(rate(nexusmind_rag_hybrid_search_total[5m]), 0.001)", "legendFormat": "error-rate" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
